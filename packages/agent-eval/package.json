{
  "name": "@warframe-companion/agent-eval",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "reports"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "eval": "npm run build && node dist/cli.js",
    "eval:v2:offline": "npm run build && node dist/v2-cli.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@warframe-companion/agent-runtime": "0.1.0",
    "@warframe-companion/market-query-contract": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}

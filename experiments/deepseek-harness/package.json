{
  "name": "@warframe-companion/deepseek-harness-experiment",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Isolated DeepSeek Harness evaluation adapter for Warframe Companion",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
